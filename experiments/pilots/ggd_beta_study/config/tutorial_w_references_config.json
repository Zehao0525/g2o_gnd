{
  "simulation": {
    "num_nodes": 300,
    "seed": 37,
    "num_tests": 100,
    "sensor_offset": [0.2, 0.1, -0.1],
    "transition_prob": 0.95,
    "gps_std": 2.5,
    "gps_period": 30,
    "increment_gps_period": false
  },

  "optimization": {
    "opt_iterations": 20,
    "ggd_warmup_iterations": 10,
    "ggd_active_iterations": 10,
    "verbose": false
  },

  "kernels": {
    "ggd_bound": 3.0,
    "ggd_power": 8.0,
    "ggd_lnc": 0.001,
    "ggd_tail_std": 2.0,
    "robust_delta": 3.0
  },

  "output": {
    "base_dir": "test_results/ggd_beta_study/references_robust_kernels_period_30"
  },

  "kernel_specs": [
    {"name": "gaussian", "type": "gaussian", "output_suffix": "gauss"},
    {"name": "ggd", "type": "ggd", "output_suffix": "ggd"},
    {"name": "huber", "type": "huber", "output_suffix": "huber"},
    {"name": "tukey", "type": "tukey", "output_suffix": "tukey"},
    {"name": "geman_mcclure", "type": "geman_mcclure", "output_suffix": "geman_mcclure"}
  ]
}
